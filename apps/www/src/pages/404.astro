---
import Base from "../layouts/Base.astro";
import "../styles/page.css";
---
<Base title="Page not found · Skovern" description="This page isn't here." noindex>
  <div class="page">
    <p class="eyebrow">404</p>
    <h1>This page isn't here.</h1>
    <p class="lede">The link may be old, or there may be a typo. Try the home page or the blog.</p>
    <div class="actions"><a class="pill fill md" href="/">Go home</a><a class="pill line md" href="/blog/">Read the blog</a></div>
  </div>
</Base>

---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import PostCard from "../../components/PostCard.astro";
import Share from "../../components/Share.astro";
import Waitlist from "../../components/Waitlist.astro";
import { author, categoryLabel, formatDate, getPosts, readMinutes, type Post } from "../../lib/posts";
import { SITE_URL } from "../../lib/site";
import "../../styles/post.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const by = author(d.author);
const minutes = readMinutes(post);
const url = `${SITE_URL}/blog/${post.id}/`;
const related = posts.filter((p) => p.id !== post.id).slice(0, 3);
const iso = (x: Date): string => x.toISOString().slice(0, 10);
const ld = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: iso(d.date),
  dateModified: iso(d.updated ?? d.date),
  author: { "@type": "Person", name: by.name, jobTitle: "Founder" },
  publisher: { "@type": "Organization", name: "Skovern", logo: { "@type": "ImageObject", url: `${SITE_URL}/apple-touch-icon.png` } },
  image: `${SITE_URL}/og.png`,
  mainEntityOfPage: url,
  articleSection: categoryLabel(d.category),
  keywords: d.keywords.join(", "),
  wordCount: (post.body ?? "").replace(/<[^>]+>/g, " ").split(/\s+/).filter(Boolean).length,
  inLanguage: "en-US",
};
---
<Base title={`${d.title} · Skovern Blog`} description={d.description} type="article" current="blog" joinHref="#join">
  <Fragment slot="head">
    <meta name="author" content={by.name}>
    <meta property="article:published_time" content={iso(d.date)}>
    <meta property="article:section" content={categoryLabel(d.category)}>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>
  <div class="progress" id="progress" aria-hidden="true"></div>
  <article>
    <header class="ahead">
      <p class="crumbs"><a href="/blog/">Blog</a> · <span>{categoryLabel(d.category)}</span></p>
      <h1>{d.title}</h1>
      <p class="deck">{d.description}</p>
      <div class="byline">
        <span class="who"><span class="av" aria-hidden="true">{by.name.slice(0, 1)}</span><span><b>{by.name}, {by.role}</b><br><time datetime={iso(d.date)}>{formatDate(d.date)}</time> <span class="dot">·</span> {minutes} min read</span></span>
      </div>
    </header>

    <figure class="hero-fig">
      <Cover cover={d.cover} alt={d.coverAlt ?? ""}>
        {d.cover === "icon" && <>
          <span class="rc-chip" style="left:6%;top:16%;--c:#30d158"><i></i>Chat: order for Mrs. Patel <small>· stayed on this computer</small></span>
          <span class="rc-chip" style="right:6%;bottom:14%;--c:#e87a2e"><i></i>Checked for an update <small>· github.com</small></span>
        </>}
      </Cover>
      {d.cover === "icon" && <figcaption>Green means it stayed on your computer. Orange means something went out, and it says where.</figcaption>}
    </figure>

    <div class="layout">
      <aside class="toc" aria-label="On this page">
        <nav>
          <p>On this page</p>
          <ol id="toc">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          <Share url={url} title={d.title} />
        </nav>
      </aside>
      <div class="body" id="post-body">
        <Content />
        <Share url={url} title={d.title} class="inline-share" />
      </div>
      <div aria-hidden="true"></div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="h-rel">
      <h2 id="h-rel">Keep reading</h2>
      <div class="cards">{related.map((p) => <PostCard post={p} />)}</div>
    </section>
  )}

  <section class="endjoin" id="join" aria-labelledby="h-join">
    <div class="box">
      <div>
        <img src="/img/icon-front.webp" alt="" width="512" height="512" loading="lazy" decoding="async">
        <h2 id="h-join">Try it when it's ready.</h2>
        <p class="l">Skovern is free AI for your shop, and you control what leaves your computer. Join the waitlist and we'll email you when your invite is ready.</p>
      </div>
      <Waitlist id="wl-post" />
    </div>
  </section>
</Base>
<script>
  import { startPost } from "../../scripts/post";
  startPost();
</script>

---
import Base from "../../layouts/Base.astro";
import "../../styles/page.css";

// Where the waitlist form lands when it runs without JavaScript: the api
// redirects here with ?n=<number> or ?error=<field>.
---
<Base title="You're on the list · Skovern" description="You're on the Skovern waitlist." noindex>
  <div class="page" id="done" data-state="ok">
    <div data-ok>
      <p class="eyebrow">Waitlist</p>
      <h1>You're on the list.</h1>
      <p class="done-num" id="done-num" aria-live="polite"></p>
      <p class="lede">We'll email you when your invite is ready. Check your inbox for a welcome note. It has a link to leave the list, if you ever want to.</p>
      <div class="actions"><a class="pill fill md" href="/">Back to Skovern</a><a class="pill line md" href="/blog/">Read the blog</a></div>
    </div>
    <div data-error hidden>
      <p class="eyebrow">Waitlist</p>
      <h1>That didn't go through.</h1>
      <p class="lede" id="done-why">Something in the form needs a fix.</p>
      <div class="actions"><a class="pill fill md" href="/#waitlist">Try again</a></div>
    </div>
  </div>
</Base>
<script>
  import { startDone } from "../../scripts/done";
  startDone();
</script>

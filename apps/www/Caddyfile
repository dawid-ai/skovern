# skovern.com static server (Railway service "www"). Railway's edge terminates
# TLS and forwards plain HTTP to $PORT (8080).
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	@www host www.skovern.com
	redir @www https://skovern.com{uri} 308

	header {
		# Everything is first-party: no inline scripts or styles, no third-party
		# hosts. The waitlist form talks to the api, and only the api.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$API_ORIGIN}; form-action 'self' {$API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		Cache-Control "public, max-age=300"
	}

	# Hashed build assets never change; the hero frames change only with a new render.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@art path /hero/* /img/* /og.png /favicon.png /favicon-32.png /apple-touch-icon.png
	header @art Cache-Control "public, max-age=604800"

	file_server

	handle_errors {
		@missing expression {err.status_code} == 404
		handle @missing {
			rewrite * /404.html
			file_server
		}
		respond "{err.status_code}" {err.status_code}
	}
}

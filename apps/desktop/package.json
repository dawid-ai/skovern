{
  "name": "@skovern/desktop",
  "private": true,
  "version": "0.0.1",
  "description": "Skovern desktop app (Electron shell + React UI)",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "reset": "node scripts/reset-userdata.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "package:win": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "test:packaging": "playwright test packaging.spec.ts"
  },
  "dependencies": {
    "@skovern/core": "workspace:^",
    "@skovern/plugin-sdk": "workspace:^",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "systeminformation": "^5.31.16"
  },
  "devDependencies": {
    "@dawid-ai/model-fit": "link:../../../model-fit",
    "@skovern/site": "workspace:^",
    "@playwright/test": "^1.61.1",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "pg": "^8.13.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "node-llama-cpp": "^3.19.0"
  }
}

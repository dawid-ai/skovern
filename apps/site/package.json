{
  "name": "@deskhand/site",
  "private": true,
  "version": "0.0.1",
  "description": "deskhand project site + cloud API (accounts, news, DM, publish)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/main.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "vitest": "^4.1.10"
  }
}

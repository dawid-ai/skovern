{
  "meta": {
    "purpose": "A reference map of local, freely-downloadable models across every modality a Skovern tool/plugin might need. A tool picks a model by (a) the job it's doing and (b) the user's hardware. Seed to curate + expand — not complete, not verified.",
    "hosting": "We do NOT host models and store NO file hashes here. Every entry points upstream via `source`. Acquisition + verification is the job of the runtime/plugin that uses the model. The separate catalog/models.json (chat brains the app itself downloads + sha256-gates directly from Hugging Face) is unrelated and unchanged.",
    "status": "seed — 2026-07-19, awaiting curation",
    "fields": {
      "id": "stable kebab-case slug",
      "name": "display name",
      "family": "model family",
      "task": "one of `tasks` below — the modality/job",
      "useCases": "plain-language jobs this is good for",
      "params": "parameter count (e.g. '8B'), or 'n/a' for diffusion / classic-CV models",
      "minVramGB": "minimum GPU VRAM to run at the recommended quant; a smaller quant lowers it; 0 = no GPU needed",
      "cpuOk": "true = runs on CPU with no GPU (slower, but does the job) — e.g. Whisper, embeddings, OCR",
      "quants": "quantisations available (lower = smaller + less VRAM, slightly worse)",
      "runtime": "one of `runtimes` below — decides which plugin can host it",
      "source": "upstream repo / home (Hugging Face id or URL) — where to GET it",
      "license": "license + freedom note",
      "free": "true = free to use (incl. local commercial); false entries are excluded per policy",
      "gated": "true = the upstream repo requires accepting a license / login before download",
      "licenseClass": "'standard' = plain OSI/permissive (Apache/MIT/BSD/CC-BY); 'custom' = open weights but bespoke terms (Gemma/Llama/Stability/OpenRAIL) — show a '*' and link the terms; it's the model maker's legal surface, not ours",
      "notes": "anything a curator should know"
    },
    "tasks": {
      "text": "general writing / chat / summarising",
      "agentic": "reasoning, planning, tool-use, 'think it through'",
      "code": "code generation / completion / explanation",
      "vision": "understand an image — describe, VQA, tag",
      "ocr": "scan / photo of a document -> text",
      "image-gen": "text -> image",
      "image-edit": "upscale, inpaint, background removal, edit",
      "stt": "speech -> text (transcription)",
      "tts": "text -> speech",
      "embedding": "text -> vector, for local search / RAG",
      "rerank": "reorder search results by relevance",
      "translation": "translate between languages",
      "moderation": "classify content for safety / policy",
      "_reserved": "future, no seed yet: video understanding, audio/music generation, speaker diarization"
    },
    "runtimes": {
      "gguf": "llama.cpp / node-llama-cpp — text, agentic, code, vision(+mmproj); Skovern's built-in engine",
      "whisper.cpp": "ggml Whisper — stt",
      "ctranslate2": "faster-whisper / NeMo-exported — stt",
      "sd.cpp": "stable-diffusion.cpp (quantised, GPU) — image-gen/-edit",
      "diffusers": "python diffusers/ComfyUI (full-fat) — image-gen/-edit",
      "onnx": "ONNX Runtime (cross-platform, CPU-friendly) — ocr, embedding, tts, rerank, translation",
      "native": "classic CV / purpose tool (Tesseract, PaddleOCR, Piper, Real-ESRGAN)"
    },
    "vramTiersGB": [0, 1, 2, 4, 6, 8, 12, 16, 24, 32, 48, 80],
    "hardwareNotes": "Tiers are common dedicated-GPU VRAM sizes; 0 = integrated/no GPU (see cpuOk). Apple unified memory shares system RAM as VRAM (a 16 GB Mac ~= a 10-12 GB card after the OS). Multi-GPU / dedicated rigs sum VRAM. New cards keep raising the ceiling — the ladder is open-ended (add 48/80/128+ as they land). The real question is never 'good enough computer?' but 'good enough for THIS job?' — a weak box runs Whisper + OCR + embeddings fine while being hopeless at image-gen."
  },
